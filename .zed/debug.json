// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "Debugpy",
    "label": "pytest '…esearch/main.py'",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": ["\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "module": "pytest",
  },
  {
    "adapter": "Debugpy",
    "label": "Debug main.py with args",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": [
      "--model_config",
      "base",
      "--dataset",
      "seq-mnist",
      "--backbone",
      "mnistmlp",
      "--model",
      "ewc-on",
      "--lr",
      "0.03",
      "--e_lambda",
      "90",
      "--gamma",
      "1.0",
      "--batch_size",
      "10",
      "--n_epochs",
      "1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "program": "$ZED_WORKTREE_ROOT/main.py",
  },
]
