// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "Debugpy",
    "label": "pytest '…esearch/main.py'",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": ["\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "module": "pytest",
  },
  {
    "adapter": "Debugpy",
    "label": "Debug main.py with args",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": [
      "--dataset",
      "seq-cifar100",
      "--model",
      "xder",
      "--buffer_size",
      "200",
      "--m",
      "0.7",
      "--alpha",
      "0.3",
      "--beta",
      "0.8",
      "--gamma",
      "0.85",
      "--optim_wd",
      "0",
      "--lambd",
      "0.05",
      "--eta",
      "0.001",
      "--lr",
      "0.03",
      "--simclr_temp",
      "5",
      "--optim_mom",
      "0",
      "--simclr_batch_size",
      "64",
      "--simclr_num_aug", 
      "2",
      "--lr",
      "0.03",
      "--minibatch_size",
      "32",
      "--n_epochs",
      "50",
      "--batch_size",
      "32",
      "--model_config",
      "default"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "program": "$ZED_WORKTREE_ROOT/main.py",
  },
]
